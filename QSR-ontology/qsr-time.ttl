@prefix : <http://example.org/qsr_kg/QSRTimeOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/qsr_kg/QSRTimeOntology#> .

<http://example.org/qsr_kg/QSRTimeOntology> rdf:type owl:Ontology ;
                                             rdfs:comment "Business-aligned temporal concepts for QSR and retail analytics." ;
                                             rdfs:label "QSR Time Ontology" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/qsr_kg/QSREventsOntology#isPartOf
<http://example.org/qsr_kg/QSREventsOntology#isPartOf> rdf:type owl:ObjectProperty ;
                                                       rdfs:comment "Relates a something to be contained in a larger unit." ;
                                                       rdfs:label "is part of" .


###  http://example.org/qsr_kg/QSRTimeOntology#hasDayType
:hasDayType rdf:type owl:ObjectProperty ;
            rdfs:domain :BusinessDay ;
            rdfs:range :Day ;
            rdfs:comment "Classifies a business day according to its semantic type." ;
            rdfs:label "has day type" .


#################################################################
#    Classes
#################################################################

###  http://example.org/qsr_kg/QSRTimeOntology#BusinessDay
:BusinessDay rdf:type owl:Class ;
             rdfs:subClassOf :Day ;
             rdfs:comment "A single operational day used for sales, inventory, and performance tracking." ;
             rdfs:label "Business Day" .


###  http://example.org/qsr_kg/QSRTimeOntology#Day
:Day rdf:type owl:Class ;
     rdfs:comment "A semantic classification of a business day based on operational or cultural context." ;
     rdfs:label "Day" .


###  http://example.org/qsr_kg/QSRTimeOntology#Instant
:Instant rdf:type owl:Class ;
         rdfs:subClassOf :TemporalEntity ;
         rdfs:comment "A precise point in time, typically represented by a timestamp." ;
         rdfs:label "Instant" .


###  http://example.org/qsr_kg/QSRTimeOntology#Month
:Month rdf:type owl:Class ;
       rdfs:subClassOf :TimeUnit ;
       rdfs:comment "A calendar month used for reporting and target evaluation." ;
       rdfs:label "Month" .


###  http://example.org/qsr_kg/QSRTimeOntology#PromotionDay
:PromotionDay rdf:type owl:Class ;
              rdfs:subClassOf :Day ;
              rdfs:comment "A business day during which at least one promotion is active." ;
              rdfs:label "Promotion Day" .


###  http://example.org/qsr_kg/QSRTimeOntology#TemporalEntity
:TemporalEntity rdf:type owl:Class ;
                rdfs:comment "An abstract concept representing time-related entities." ;
                rdfs:label "Temporal Entity" .


###  http://example.org/qsr_kg/QSRTimeOntology#TimeInterval
:TimeInterval rdf:type owl:Class ;
              rdfs:subClassOf :TemporalEntity ;
              rdfs:comment "A continuous span of time with a defined start and end." ;
              rdfs:label "Time Interval" .


###  http://example.org/qsr_kg/QSRTimeOntology#TimeUnit
:TimeUnit rdf:type owl:Class ;
          rdfs:comment "A calendar-aligned temporal grouping used for aggregation and reasoning." ;
          rdfs:label "Time Unit" .


###  http://example.org/qsr_kg/QSRTimeOntology#Week
:Week rdf:type owl:Class ;
      rdfs:subClassOf :TimeUnit ;
      rdfs:comment "A calendar week grouping multiple business days." ;
      rdfs:label "Week" .


###  http://example.org/qsr_kg/QSRTimeOntology#Weekday
:Weekday rdf:type owl:Class ;
         rdfs:subClassOf :Day ;
         rdfs:comment "A standard working business day." ;
         rdfs:label "Weekday" .


###  http://example.org/qsr_kg/QSRTimeOntology#Weekend
:Weekend rdf:type owl:Class ;
         rdfs:subClassOf :Day ;
         rdfs:comment "A non-standard business day with different demand patterns." ;
         rdfs:label "Weekend" .


