@prefix : <http://example.org/qsr_kg/QSRPerformanceOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <http://example.org/qsr_kg/QSRCoreOntology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix events: <http://example.org/qsr_kg/QSREventsOntology#> .
@base <http://example.org/qsr_kg/QSRPerformanceOntology#> .

<http://example.org/qsr_kg/QSRPerformanceOntology> rdf:type owl:Ontology ;
                                                    rdfs:comment "Targets, evaluations, and performance outcomes." ;
                                                    rdfs:label "QSR Performance Ontology" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/qsr_kg/QSRPerformanceOntology#causedBy
:causedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :PerformanceEvent ;
          rdfs:range events:Event ;
          rdfs:comment "Links a performance outcome to contributing events." ;
          rdfs:label "caused by" .


#################################################################
#    Classes
#################################################################

###  http://example.org/qsr_kg/QSREventsOntology#Event
events:Event rdf:type owl:Class .


###  http://example.org/qsr_kg/QSRPerformanceOntology#PerformanceEvent
:PerformanceEvent rdf:type owl:Class ;
                  rdfs:subClassOf events:Event ;
                  rdfs:comment "An evaluative event comparing actual performance to expectations." ;
                  rdfs:label "Performance Event" .


###  http://example.org/qsr_kg/QSRPerformanceOntology#UnderperformanceEvent
:UnderperformanceEvent rdf:type owl:Class ;
                       rdfs:subClassOf :PerformanceEvent ;
                       rdfs:comment "An event indicating performance below defined targets." ;
                       rdfs:label "Underperformance Event" .


