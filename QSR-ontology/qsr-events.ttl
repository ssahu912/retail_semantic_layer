@prefix : <http://example.org/qsr_kg/QSREventsOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <http://example.org/qsr_kg/QSRCoreOntology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://example.org/qsr_kg/QSRTimeOntology#> .
@base <http://example.org/qsr_kg/QSREventsOntology#> .

<http://example.org/qsr_kg/QSREventsOntology> rdf:type owl:Ontology ;
                                               rdfs:comment "Immutable business events representing transactions, observations, and snapshots." ;
                                               rdfs:label "QSR Events Ontology" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/qsr_kg/QSREventsOntology#forStore
:forStore rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Event
                                      <http://example.org/qsr_kg/QSRPromotionsOntology#Promotion>
                                    )
                      ] ;
          rdfs:range core:Store ;
          rdfs:comment "Indicates the store at which an event occurred." ;
          rdfs:label "for store" .


###  http://example.org/qsr_kg/QSREventsOntology#occurredOn
:occurredOn rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Event
                                        <http://example.org/qsr_kg/QSRPromotionsOntology#Promotion>
                                      )
                        ] ;
            rdfs:range time:Day ;
            rdfs:comment "Associates an event with the business day on which it occurred." ;
            rdfs:label "occurred on" .


#################################################################
#    Data properties
#################################################################

###  http://example.org/qsr_kg/QSREventsOntology#hasAmount
:hasAmount rdf:type owl:DatatypeProperty ;
           rdfs:domain :Event ;
           rdfs:range xsd:decimal ;
           rdfs:comment "Represents a monetary value associated with an event." ;
           rdfs:label "has amount" .


#################################################################
#    Classes
#################################################################

###  http://example.org/qsr_kg/QSRCoreOntology#Store
core:Store rdf:type owl:Class .


###  http://example.org/qsr_kg/QSREventsOntology#Event
:Event rdf:type owl:Class ;
       rdfs:comment "An immutable occurrence in time relevant to business operations." ;
       rdfs:label "Event" .


###  http://example.org/qsr_kg/QSREventsOntology#InventorySnapshot
:InventorySnapshot rdf:type owl:Class ;
                   rdfs:subClassOf :Event ;
                   rdfs:comment "A point-in-time record of inventory levels." ;
                   rdfs:label "Inventory Snapshot" .


###  http://example.org/qsr_kg/QSREventsOntology#SalesAggregation
:SalesAggregation rdf:type owl:Class ;
                  rdfs:subClassOf :Event ;
                  rdfs:comment "An aggregated sales summary over a defined time period." ;
                  rdfs:label "Sales Aggregation" .


###  http://example.org/qsr_kg/QSREventsOntology#TransactionEvent
:TransactionEvent rdf:type owl:Class ;
                  rdfs:subClassOf :Event ;
                  rdfs:comment "A customer purchase transaction occurring at a store." ;
                  rdfs:label "Transaction Event" .


###  http://example.org/qsr_kg/QSRPromotionsOntology#Promotion
<http://example.org/qsr_kg/QSRPromotionsOntology#Promotion> rdf:type owl:Class .


###  http://example.org/qsr_kg/QSRTimeOntology#BusinessDay
time:BusinessDay rdf:type owl:Class .


###  http://example.org/qsr_kg/QSRTimeOntology#Day
time:Day rdf:type owl:Class .


