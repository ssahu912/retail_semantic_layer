@prefix : <http://example.org/qsr_kg/QSRInventoryOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <http://example.org/qsr_kg/QSRCoreOntology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/qsr_kg/QSRInventoryOntology#> .

<http://example.org/qsr_kg/QSRInventoryOntology> rdf:type owl:Ontology ;
                                                  rdfs:comment "Inventory items, inventory state over time, and business rules governing stock levels." ;
                                                  rdfs:label "QSR Inventory Ontology" .

#################################################################
#    Data properties
#################################################################

###  http://example.org/qsr_kg/QSRInventoryOntology#hasThreshold
:hasThreshold rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:decimal ;
              rdfs:comment "Defines a numeric threshold used in inventory rules, such as reorder points." ;
              rdfs:label "has threshold" .


#################################################################
#    Classes
#################################################################

###  http://example.org/qsr_kg/QSRInventoryOntology#InventoryItem
:InventoryItem rdf:type owl:Class ;
               rdfs:comment "An item stocked at a store for operational use, including ingredients and packaging." ;
               rdfs:label "Inventory Item" .


