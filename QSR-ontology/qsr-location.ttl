@prefix : <http://example.org/qsr_kg/QSRLocationOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <http://example.org/qsr_kg/QSRCoreOntology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/qsr_kg/QSRLocationOntology#> .

<http://example.org/qsr_kg/QSRLocationOntology> rdf:type owl:Ontology ;
                                                 rdfs:comment "Geographic and spatial context for stores, including nearby points of interest." ;
                                                 rdfs:label "QSR Location Ontology" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/qsr_kg/QSRLocationOntology#hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             rdfs:domain core:Store ;
             rdfs:range :Location ;
             rdfs:comment "Associates a store with its geographic location." ;
             rdfs:label "has location" .


###  http://example.org/qsr_kg/QSRLocationOntology#hasPOICategory
:hasPOICategory rdf:type owl:ObjectProperty ;
                rdfs:domain :PointOfInterest ;
                rdfs:range :POICategory ;
                rdfs:comment "Classifies a point of interest by its type." ;
                rdfs:label "has POI category" .


###  http://example.org/qsr_kg/QSRLocationOntology#near
:near rdf:type owl:ObjectProperty ;
      rdfs:domain core:Store ;
      rdfs:range :PointOfInterest ;
      rdfs:comment "Indicates that a store is geographically close to a point of interest." ;
      rdfs:label "near" .


#################################################################
#    Data properties
#################################################################

###  http://example.org/qsr_kg/QSRLocationOntology#latitude
:latitude rdf:type owl:DatatypeProperty ;
          rdfs:domain :Location ;
          rdfs:range xsd:decimal ;
          rdfs:comment "The latitude coordinate of a point of interest." ;
          rdfs:label "latitude" .


###  http://example.org/qsr_kg/QSRLocationOntology#longitude
:longitude rdf:type owl:DatatypeProperty ;
           rdfs:domain :Location ;
           rdfs:range xsd:decimal ;
           rdfs:comment "The longitude coordinate of a point of interest." ;
           rdfs:label "longitude" .


#################################################################
#    Classes
#################################################################

###  http://example.org/qsr_kg/QSRCoreOntology#Store
core:Store rdf:type owl:Class .


###  http://example.org/qsr_kg/QSRLocationOntology#Location
:Location rdf:type owl:Class ;
          rdfs:comment "A geographic place associated with a store, such as a city district or mall." ;
          rdfs:label "Location" .


###  http://example.org/qsr_kg/QSRLocationOntology#POICategory
:POICategory rdf:type owl:Class ;
             rdfs:comment "A semantic classification of a point of interest, such as Mall, Office, or School." ;
             rdfs:label "POI Category" .


###  http://example.org/qsr_kg/QSRLocationOntology#PointOfInterest
:PointOfInterest rdf:type owl:Class ;
                 rdfs:comment "A nearby landmark or place that may influence customer footfall." ;
                 rdfs:label "Point of Interest" .


