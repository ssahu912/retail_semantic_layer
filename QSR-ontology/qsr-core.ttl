@prefix : <http://example.org/qsr_kg/QSRCoreOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/qsr_kg/QSRCoreOntology#> .

<http://example.org/qsr_kg/QSRCoreOntology> rdf:type owl:Ontology ;
                                             rdfs:comment "Core business entities common to retail and quick service restaurant domains." ;
                                             rdfs:label "QSR Core Ontology" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/qsr_kg#operatesStore
:operatesStore rdf:type owl:ObjectProperty ;
               rdfs:domain :Organization ;
               rdfs:range :Store ;
               rdfs:comment "Relates an organization to a store that it operates." ;
               rdfs:label "operates store" .


#################################################################
#    Classes
#################################################################

###  http://example.org/qsr_kg#Organization
:Organization rdf:type owl:Class ;
              rdfs:comment "A legal or commercial entity that owns or operates one or more stores." ;
              rdfs:label "Organization" .


###  http://example.org/qsr_kg#Product
:Product rdf:type owl:Class ;
         rdfs:comment "An item offered for sale to customers, including food, beverages, or bundles." ;
         rdfs:label "Product" .


###  http://example.org/qsr_kg#ProductCategory
:ProductCategory rdf:type owl:Class ;
                 rdfs:comment "A classification grouping products by type, usage, or business role." ;
                 rdfs:label "Product Category" .


###  http://example.org/qsr_kg#Store
:Store rdf:type owl:Class ;
       rdfs:comment "A physical retail or food service outlet operated by an organization." ;
       rdfs:label "Store" .


:isDriveThru rdf:type owl:DatatypeProperty ;
             rdfs:comment "Indicates if the store has drive-thru capability." ;
             rdfs:range xsd:boolean ;
             rdfs:label "is drive thru" ;
             rdfs:domain :Store .


:isDeliveryEnabled rdf:type owl:DatatypeProperty ;
                   rdfs:comment "Indicates if the store supports delivery orders." ;
                   rdfs:range xsd:boolean ;
                   rdfs:domain :Store ;
                   rdfs:label "is delivery enabled" .


