@prefix : <http://example.org/qsr_kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix events: <http://example.org/qsr_kg/QSREventsOntology#> .
@prefix timeOnt: <http://example.org/qsr_kg/QSRTimeOntology#> .
@prefix location: <http://example.org/qsr_kg/QSRLocationOntology#> .
@prefix inventory: <http://example.org/qsr_kg/QSRInventoryOntology#> .
@prefix promotions: <http://example.org/qsr_kg/QSRPromotionsOntology#> .
@prefix competition: <http://example.org/qsr_kg/QSRCompetitionOntology#> .
@prefix performance: <http://example.org/qsr_kg/QSRPerformanceOntology#> .
@base <http://example.org/qsr_kg#> .

<http://example.org/qsr_kg/BurgerHaven#> rdf:type owl:Ontology ;
                                          owl:imports <http://example.org/qsr_kg> ,
                                                      <http://example.org/qsr_kg/QSRCompetitionOntology> ,
                                                      <http://example.org/qsr_kg/QSRCoreOntology> ,
                                                      <http://example.org/qsr_kg/QSREventsOntology> ,
                                                      <http://example.org/qsr_kg/QSRInventoryOntology> ,
                                                      <http://example.org/qsr_kg/QSRLocationOntology> ,
                                                      <http://example.org/qsr_kg/QSRPerformanceOntology> ,
                                                      <http://example.org/qsr_kg/QSRPromotionsOntology> ;
                                          rdfs:comment "Knowledge graph for Burger Haven QSR chain, integrating core business, locations, events, inventory, promotions, performance, and competition data." ;
                                          rdfs:label "Burger Haven Knowledge Graph" .

#################################################################
#    Individuals
#################################################################

###  http://example.org/qsr_kg#CASH
:CASH rdf:type owl:NamedIndividual ,
               :PaymentMethod .


###  http://example.org/qsr_kg#CREDIT_CARD
:CREDIT_CARD rdf:type owl:NamedIndividual ,
                      :PaymentMethod .


###  http://example.org/qsr_kg#DEBIT_CARD
:DEBIT_CARD rdf:type owl:NamedIndividual ,
                     :PaymentMethod .


###  http://example.org/qsr_kg#DELIVERY
:DELIVERY rdf:type owl:NamedIndividual ,
                   :OrderChannel .


###  http://example.org/qsr_kg#DIGITAL_WALLET
:DIGITAL_WALLET rdf:type owl:NamedIndividual ,
                         :PaymentMethod .


###  http://example.org/qsr_kg#DINE_IN
:DINE_IN rdf:type owl:NamedIndividual ,
                  :OrderChannel .


###  http://example.org/qsr_kg#DRIVE_THRU
:DRIVE_THRU rdf:type owl:NamedIndividual ,
                     :OrderChannel .


###  http://example.org/qsr_kg#MADA
:MADA rdf:type owl:NamedIndividual ,
               :PaymentMethod .


###  http://example.org/qsr_kg#TAKEAWAY
:TAKEAWAY rdf:type owl:NamedIndividual ,
                   :OrderChannel .


