@prefix : <http://example.org/qsr_kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <http://example.org/qsr_kg/QSRCoreOntology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix time: <http://example.org/qsr_kg/QSRTimeOntology#> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix events: <http://example.org/qsr_kg/QSREventsOntology#> .
@prefix qsr_kg: <http://example.org/qsr_kg#> .
@prefix location: <http://example.org/qsr_kg/QSRLocationOntology#> .
@prefix performance: <http://example.org/qsr_kg/QSRPerformanceOntology#> .
@prefix QSREventsOntology: <http://example.org/qsr_kg/QSREventsOntology#> .
@prefix QSRLocationOntology: <http://example.org/qsr_kg/QSRLocationOntology#> .
@prefix QSRPromotionsOntology: <http://example.org/qsr_kg/QSRPromotionsOntology#> .
@base <http://example.org/qsr_kg#> .

<http://example.org/qsr_kg#> rdf:type owl:Ontology ;
                              rdfs:comment "Knowledge graph for Burger Haven QSR chain, integrating core business, locations, events, inventory, promotions, performance, and competition data." ;
                              rdfs:label "Burger Haven Knowledge Graph" .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
swrla:isRuleEnabled rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/qsr_kg#hasDayOfWeek
qsr_kg:hasDayOfWeek rdf:type owl:ObjectProperty ;
                    rdfs:domain time:BusinessDay ;
                    rdfs:range time:DayOfWeek .


###  http://example.org/qsr_kg#hasOrderChannel
qsr_kg:hasOrderChannel rdf:type owl:ObjectProperty ;
                       rdfs:domain QSREventsOntology:TransactionEvent ;
                       rdfs:range qsr_kg:OrderChannel .


###  http://example.org/qsr_kg#hasPaymentMethod
qsr_kg:hasPaymentMethod rdf:type owl:ObjectProperty ;
                        rdfs:domain QSREventsOntology:TransactionEvent ;
                        rdfs:range qsr_kg:PaymentMethod .


###  http://example.org/qsr_kg#hasWeather
qsr_kg:hasWeather rdf:type owl:ObjectProperty ;
                  rdfs:domain time:Day ;
                  rdfs:range qsr_kg:Weather .


###  http://example.org/qsr_kg#isApplicableOn
qsr_kg:isApplicableOn rdf:type owl:ObjectProperty ;
                      rdfs:domain QSRPromotionsOntology:Promotion ;
                      rdfs:range time:DayOfWeek .


###  http://example.org/qsr_kg/QSRCompetitionOntology#hasCompetitorType
<http://example.org/qsr_kg/QSRCompetitionOntology#hasCompetitorType> rdf:type owl:ObjectProperty ;
                                                                     rdfs:domain <http://example.org/qsr_kg/QSRCompetitionOntology#Competitor> ;
                                                                     rdfs:range <http://example.org/qsr_kg/QSRCompetitionOntology#CompetitorType> ;
                                                                     rdfs:comment "Associates a competitor with its market classification." ;
                                                                     rdfs:label "has competitor type" .


###  http://example.org/qsr_kg/QSREventsOntology#aggregatesOn
QSREventsOntology:aggregatesOn rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf QSREventsOntology:occurredOn ;
                               rdfs:domain QSREventsOntology:SalesAggregation ;
                               rdfs:range time:BusinessDay .


###  http://example.org/qsr_kg/QSREventsOntology#forStore
QSREventsOntology:forStore rdf:type owl:ObjectProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( QSREventsOntology:Event
                                                       QSRPromotionsOntology:Promotion
                                                     )
                                       ] ;
                           rdfs:range core:Store ;
                           rdfs:comment "Indicates the store at which an event occurred." ;
                           rdfs:label "for store" .


###  http://example.org/qsr_kg/QSREventsOntology#isPartOf
QSREventsOntology:isPartOf rdf:type owl:ObjectProperty ;
                           rdfs:domain QSREventsOntology:Event ;
                           rdfs:range QSREventsOntology:Event ;
                           owl:propertyChainAxiom ( QSREventsOntology:transactionOccuredOn
                                                    [ owl:inverseOf QSREventsOntology:aggregatesOn
                                                    ]
                                                  ) ;
                           rdfs:comment "Relates a something to be contained in a larger unit." ;
                           rdfs:label "is part of" .


###  http://example.org/qsr_kg/QSREventsOntology#occurredOn
QSREventsOntology:occurredOn rdf:type owl:ObjectProperty ;
                             rdfs:domain [ rdf:type owl:Class ;
                                           owl:unionOf ( QSREventsOntology:Event
                                                         QSRPromotionsOntology:Promotion
                                                       )
                                         ] ;
                             rdfs:range time:Day ;
                             rdfs:comment "Associates an event with the business day on which it occurred." ;
                             rdfs:label "occurred on" .


###  http://example.org/qsr_kg/QSREventsOntology#transactionOccuredOn
QSREventsOntology:transactionOccuredOn rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf QSREventsOntology:occurredOn ;
                                       rdfs:domain QSREventsOntology:TransactionEvent ;
                                       rdfs:range time:BusinessDay .


###  http://example.org/qsr_kg/QSRInventoryOntology#hasInventoryItem
<http://example.org/qsr_kg/QSRInventoryOntology#hasInventoryItem> rdf:type owl:ObjectProperty ;
                                                                  rdfs:domain QSREventsOntology:InventorySnapshot ;
                                                                  rdfs:range <http://example.org/qsr_kg/QSRInventoryOntology#InventoryItem> .


###  http://example.org/qsr_kg/QSRLocationOntology#hasLocation
QSRLocationOntology:hasLocation rdf:type owl:ObjectProperty ;
                                rdfs:domain core:Store ;
                                rdfs:range QSRLocationOntology:Location ;
                                rdfs:comment "Associates a store with its geographic location." ;
                                rdfs:label "has location" .


###  http://example.org/qsr_kg/QSRLocationOntology#hasPOICategory
QSRLocationOntology:hasPOICategory rdf:type owl:ObjectProperty ;
                                   rdfs:domain QSRLocationOntology:PointOfInterest ;
                                   rdfs:range QSRLocationOntology:POICategory ;
                                   rdfs:comment "Classifies a point of interest by its type." ;
                                   rdfs:label "has POI category" .


###  http://example.org/qsr_kg/QSRLocationOntology#near
QSRLocationOntology:near rdf:type owl:ObjectProperty ;
                         rdfs:domain core:Store ;
                         rdfs:range QSRLocationOntology:PointOfInterest ;
                         rdfs:comment "Indicates that a store is geographically close to a point of interest." ;
                         rdfs:label "near" .


###  http://example.org/qsr_kg/QSRPerformanceOntology#causedBy
performance:causedBy rdf:type owl:ObjectProperty ;
                     rdfs:domain performance:PerformanceEvent ;
                     rdfs:range QSREventsOntology:Event ;
                     rdfs:comment "Links a performance outcome to contributing events." ;
                     rdfs:label "caused by" .


###  http://example.org/qsr_kg/QSRPromotionsOntology#hasEndingBusinessDay
QSRPromotionsOntology:hasEndingBusinessDay rdf:type owl:ObjectProperty ;
                                           rdfs:subPropertyOf QSREventsOntology:occurredOn ;
                                           rdfs:domain QSRPromotionsOntology:Promotion ;
                                           rdfs:range time:BusinessDay .


###  http://example.org/qsr_kg/QSRPromotionsOntology#hasInterval
QSRPromotionsOntology:hasInterval rdf:type owl:ObjectProperty ;
                                  rdfs:domain QSRPromotionsOntology:Promotion ;
                                  rdfs:range time:TimeInterval ;
                                  rdfs:comment "Associates a promotion with the time interval during which it applies." ;
                                  rdfs:label "has interval" .


###  http://example.org/qsr_kg/QSRPromotionsOntology#hasStartingBusinessDay
QSRPromotionsOntology:hasStartingBusinessDay rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf QSREventsOntology:occurredOn ;
                                             rdfs:domain QSRPromotionsOntology:Promotion ;
                                             rdfs:range time:BusinessDay .


###  http://example.org/qsr_kg/QSRTimeOntology#hasDayType
time:hasDayType rdf:type owl:ObjectProperty ;
                rdfs:domain time:BusinessDay ;
                rdfs:range time:Day ;
                rdfs:comment "Classifies a business day according to its semantic type." ;
                rdfs:label "has day type" .


#################################################################
#    Data properties
#################################################################

###  http://example.org/qsr_kg#condition
qsr_kg:condition rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain qsr_kg:Weather ;
                 rdfs:range xsd:string ;
                 rdfs:comment "weather condition Hot, Warm, etc" .


###  http://example.org/qsr_kg#customerSatisfactionRating
qsr_kg:customerSatisfactionRating rdf:type owl:DatatypeProperty ;
                                  rdfs:subPropertyOf owl:topDataProperty ;
                                  rdfs:domain QSREventsOntology:TransactionEvent ;
                                  rdfs:range xsd:integer .


###  http://example.org/qsr_kg#date
qsr_kg:date rdf:type owl:DatatypeProperty ;
            rdfs:range xsd:string .


###  http://example.org/qsr_kg#id
qsr_kg:id rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:comment "Unique Identifier of the entity" ;
          rdfs:label "id" .


###  http://example.org/qsr_kg#name
qsr_kg:name rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:comment "Nmae of the entity" ;
            rdfs:label "name" .


###  http://example.org/qsr_kg#orderWaitTime
qsr_kg:orderWaitTime rdf:type owl:DatatypeProperty ;
                     rdfs:domain QSREventsOntology:TransactionEvent ;
                     rdfs:range xsd:integer ;
                     rdfs:comment "Time in mins taken by the order to be successfully completed" .


###  http://example.org/qsr_kg#temperatureHigh
qsr_kg:temperatureHigh rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain qsr_kg:Weather ;
                       rdfs:range xsd:decimal .


###  http://example.org/qsr_kg#temperatureLow
qsr_kg:temperatureLow rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain qsr_kg:Weather ;
                      rdfs:range xsd:decimal .


###  http://example.org/qsr_kg#unitsOfMeasure
qsr_kg:unitsOfMeasure rdf:type owl:DatatypeProperty ;
                      rdfs:domain <http://example.org/qsr_kg/QSRInventoryOntology#InventoryItem> ;
                      rdfs:range xsd:string .


###  http://example.org/qsr_kg/QSRCoreOntology#revenueTarget
core:revenueTarget rdf:type owl:DatatypeProperty ;
                   rdfs:domain core:Store ;
                   rdfs:range xsd:integer .


###  http://example.org/qsr_kg/QSREventsOntology#hasAmount
QSREventsOntology:hasAmount rdf:type owl:DatatypeProperty ;
                            rdfs:domain QSREventsOntology:Event ;
                            rdfs:range xsd:decimal ;
                            rdfs:comment "Represents a monetary value associated with an event." ;
                            rdfs:label "has amount" .


###  http://example.org/qsr_kg/QSRInventoryOntology#hasThreshold
<http://example.org/qsr_kg/QSRInventoryOntology#hasThreshold> rdf:type owl:DatatypeProperty ;
                                                              rdfs:range xsd:decimal ;
                                                              rdfs:comment "Defines a numeric threshold used in inventory rules, such as reorder points." ;
                                                              rdfs:label "has threshold" .


###  http://example.org/qsr_kg/QSRInventoryOntology#reorderThreshold
<http://example.org/qsr_kg/QSRInventoryOntology#reorderThreshold> rdf:type owl:DatatypeProperty ;
                                                                  rdfs:domain <http://example.org/qsr_kg/QSRInventoryOntology#InventoryItem> ;
                                                                  rdfs:range xsd:integer .


###  http://example.org/qsr_kg/QSRLocationOntology#latitude
QSRLocationOntology:latitude rdf:type owl:DatatypeProperty ;
                             rdfs:domain QSRLocationOntology:Location ;
                             rdfs:range xsd:decimal ;
                             rdfs:comment "The latitude coordinate of a point of interest." ;
                             rdfs:label "latitude" .


###  http://example.org/qsr_kg/QSRLocationOntology#longitude
QSRLocationOntology:longitude rdf:type owl:DatatypeProperty ;
                              rdfs:domain QSRLocationOntology:Location ;
                              rdfs:range xsd:decimal ;
                              rdfs:comment "The longitude coordinate of a point of interest." ;
                              rdfs:label "longitude" .


#################################################################
#    Classes
#################################################################

###  http://dbpedia.org/ontology/City
<http://dbpedia.org/ontology/City> rdf:type owl:Class ;
                                   rdfs:subClassOf QSRLocationOntology:Location .


###  http://dbpedia.org/ontology/Country
<http://dbpedia.org/ontology/Country> rdf:type owl:Class ;
                                      rdfs:subClassOf QSRLocationOntology:Location .


###  http://example.org/qsr_kg#OrderChannel
qsr_kg:OrderChannel rdf:type owl:Class .


###  http://example.org/qsr_kg#PaymentMethod
qsr_kg:PaymentMethod rdf:type owl:Class .


###  http://example.org/qsr_kg#Weather
qsr_kg:Weather rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty qsr_kg:condition ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty qsr_kg:temperatureHigh ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:decimal
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty qsr_kg:temperatureLow ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:decimal
                               ] .


###  http://example.org/qsr_kg/QSRCompetitionOntology#Competitor
<http://example.org/qsr_kg/QSRCompetitionOntology#Competitor> rdf:type owl:Class ;
                                                              rdfs:comment "An external organization offering similar products or services in the same market." ;
                                                              rdfs:label "Competitor" .


###  http://example.org/qsr_kg/QSRCompetitionOntology#CompetitorType
<http://example.org/qsr_kg/QSRCompetitionOntology#CompetitorType> rdf:type owl:Class ;
                                                                  rdfs:comment "A classification of competitors based on scale or market positioning." ;
                                                                  rdfs:label "Competitor Type" .


###  http://example.org/qsr_kg/QSRCompetitionOntology#GlobalChain
<http://example.org/qsr_kg/QSRCompetitionOntology#GlobalChain> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://example.org/qsr_kg/QSRCompetitionOntology#CompetitorType> ;
                                                               rdfs:comment "A competitor operating across multiple countries or regions." ;
                                                               rdfs:label "Global Chain" .


###  http://example.org/qsr_kg/QSRCompetitionOntology#LocalChain
<http://example.org/qsr_kg/QSRCompetitionOntology#LocalChain> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://example.org/qsr_kg/QSRCompetitionOntology#CompetitorType> ;
                                                              rdfs:comment "A competitor operating within a limited geographic market." ;
                                                              rdfs:label "Local Chain" .


###  http://example.org/qsr_kg/QSRCoreOntology#Store
core:Store rdf:type owl:Class .


###  http://example.org/qsr_kg/QSREventsOntology#Event
QSREventsOntology:Event rdf:type owl:Class ;
                        rdfs:comment "An immutable occurrence in time relevant to business operations." ;
                        rdfs:label "Event" .


###  http://example.org/qsr_kg/QSREventsOntology#InventorySnapshot
QSREventsOntology:InventorySnapshot rdf:type owl:Class ;
                                    rdfs:subClassOf QSREventsOntology:Event ;
                                    owl:disjointWith QSREventsOntology:SalesAggregation ,
                                                     QSREventsOntology:TransactionEvent ;
                                    rdfs:comment "A point-in-time record of inventory levels." ;
                                    rdfs:label "Inventory Snapshot" .


###  http://example.org/qsr_kg/QSREventsOntology#SalesAggregation
QSREventsOntology:SalesAggregation rdf:type owl:Class ;
                                   rdfs:subClassOf QSREventsOntology:Event ;
                                   owl:disjointWith QSREventsOntology:TransactionEvent ;
                                   rdfs:comment "An aggregated sales summary over a defined time period." ;
                                   rdfs:label "Sales Aggregation" .


###  http://example.org/qsr_kg/QSREventsOntology#TransactionEvent
QSREventsOntology:TransactionEvent rdf:type owl:Class ;
                                   rdfs:subClassOf QSREventsOntology:Event ;
                                   rdfs:comment "A customer purchase transaction occurring at a store." ;
                                   rdfs:label "Transaction Event" .


###  http://example.org/qsr_kg/QSRInventoryOntology#InventoryItem
<http://example.org/qsr_kg/QSRInventoryOntology#InventoryItem> rdf:type owl:Class ;
                                                               rdfs:comment "An item stocked at a store for operational use, including ingredients and packaging." ;
                                                               rdfs:label "Inventory Item" .


###  http://example.org/qsr_kg/QSRLocationOntology#Location
QSRLocationOntology:Location rdf:type owl:Class ;
                             rdfs:comment "A geographic place associated with a store, such as a city district or mall." ;
                             rdfs:label "Location" .


###  http://example.org/qsr_kg/QSRLocationOntology#POICategory
QSRLocationOntology:POICategory rdf:type owl:Class ;
                                rdfs:comment "A semantic classification of a point of interest, such as Mall, Office, or School." ;
                                rdfs:label "POI Category" .


###  http://example.org/qsr_kg/QSRLocationOntology#PointOfInterest
QSRLocationOntology:PointOfInterest rdf:type owl:Class ;
                                    rdfs:comment "A nearby landmark or place that may influence customer footfall." ;
                                    rdfs:label "Point of Interest" .


###  http://example.org/qsr_kg/QSRPerformanceOntology#PerformanceEvent
performance:PerformanceEvent rdf:type owl:Class ;
                             rdfs:subClassOf QSREventsOntology:Event ;
                             rdfs:comment "An evaluative event comparing actual performance to expectations." ;
                             rdfs:label "Performance Event" .


###  http://example.org/qsr_kg/QSRPerformanceOntology#UnderperformanceEvent
performance:UnderperformanceEvent rdf:type owl:Class ;
                                  rdfs:subClassOf performance:PerformanceEvent ;
                                  rdfs:comment "An event indicating performance below defined targets." ;
                                  rdfs:label "Underperformance Event" .


###  http://example.org/qsr_kg/QSRPromotionsOntology#ActivePromotion
QSRPromotionsOntology:ActivePromotion rdf:type owl:Class ;
                                      rdfs:subClassOf QSRPromotionsOntology:PromotionPhase ;
                                      rdfs:comment "The phase during which a promotion is valid." ;
                                      rdfs:label "Active Promotion" .


###  http://example.org/qsr_kg/QSRPromotionsOntology#PostPromotion
QSRPromotionsOntology:PostPromotion rdf:type owl:Class ;
                                    rdfs:subClassOf QSRPromotionsOntology:PromotionPhase .


###  http://example.org/qsr_kg/QSRPromotionsOntology#PrePromotion
QSRPromotionsOntology:PrePromotion rdf:type owl:Class ;
                                   rdfs:subClassOf QSRPromotionsOntology:PromotionPhase .


###  http://example.org/qsr_kg/QSRPromotionsOntology#Promotion
QSRPromotionsOntology:Promotion rdf:type owl:Class ;
                                rdfs:comment "A marketing offer intended to influence customer purchasing behavior." ;
                                rdfs:label "Promotion" .


###  http://example.org/qsr_kg/QSRPromotionsOntology#PromotionPhase
QSRPromotionsOntology:PromotionPhase rdf:type owl:Class ;
                                     rdfs:comment "A temporal phase of a promotion such as pre, active, or post." ;
                                     rdfs:label "Promotion Phase" .


###  http://example.org/qsr_kg/QSRTimeOntology#BusinessDay
time:BusinessDay rdf:type owl:Class ;
                 rdfs:subClassOf time:Day ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty qsr_kg:date ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
                 rdfs:comment "A single operational day used for sales, inventory, and performance tracking." ;
                 rdfs:label "Business Day" .


###  http://example.org/qsr_kg/QSRTimeOntology#Day
time:Day rdf:type owl:Class ;
         rdfs:subClassOf time:TimeUnit ;
         rdfs:comment "A semantic classification of a business day based on operational or cultural context." ;
         rdfs:label "Day" .


###  http://example.org/qsr_kg/QSRTimeOntology#DayOfWeek
time:DayOfWeek rdf:type owl:Class ;
               rdfs:subClassOf time:Day .


###  http://example.org/qsr_kg/QSRTimeOntology#Instant
time:Instant rdf:type owl:Class ;
             rdfs:subClassOf time:TemporalEntity ;
             rdfs:comment "A precise point in time, typically represented by a timestamp." ;
             rdfs:label "Instant" .


###  http://example.org/qsr_kg/QSRTimeOntology#Month
time:Month rdf:type owl:Class ;
           rdfs:subClassOf time:TimeUnit ;
           rdfs:comment "A calendar month used for reporting and target evaluation." ;
           rdfs:label "Month" .


###  http://example.org/qsr_kg/QSRTimeOntology#PromotionDay
time:PromotionDay rdf:type owl:Class ;
                  rdfs:subClassOf time:Day ;
                  rdfs:comment "A business day during which at least one promotion is active." ;
                  rdfs:label "Promotion Day" .


###  http://example.org/qsr_kg/QSRTimeOntology#TemporalEntity
time:TemporalEntity rdf:type owl:Class ;
                    rdfs:comment "An abstract concept representing time-related entities." ;
                    rdfs:label "Temporal Entity" .


###  http://example.org/qsr_kg/QSRTimeOntology#TimeInterval
time:TimeInterval rdf:type owl:Class ;
                  rdfs:subClassOf time:TemporalEntity ;
                  rdfs:comment "A continuous span of time with a defined start and end." ;
                  rdfs:label "Time Interval" .


###  http://example.org/qsr_kg/QSRTimeOntology#TimeUnit
time:TimeUnit rdf:type owl:Class ;
              rdfs:comment "A calendar-aligned temporal grouping used for aggregation and reasoning." ;
              rdfs:label "Time Unit" .


###  http://example.org/qsr_kg/QSRTimeOntology#Week
time:Week rdf:type owl:Class ;
          rdfs:subClassOf time:TimeUnit ;
          rdfs:comment "A calendar week grouping multiple business days." ;
          rdfs:label "Week" .


###  http://example.org/qsr_kg/QSRTimeOntology#Weekday
time:Weekday rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:unionOf ( [ rdf:type owl:Restriction ;
                                                   owl:onProperty qsr_kg:hasDayOfWeek ;
                                                   owl:hasValue qsr_kg:Monday
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty qsr_kg:hasDayOfWeek ;
                                                   owl:hasValue qsr_kg:Sunday
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty qsr_kg:hasDayOfWeek ;
                                                   owl:hasValue qsr_kg:Thursday
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty qsr_kg:hasDayOfWeek ;
                                                   owl:hasValue qsr_kg:Tuesday
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty qsr_kg:hasDayOfWeek ;
                                                   owl:hasValue qsr_kg:Wednesday
                                                 ]
                                               )
                                 ] ;
             rdfs:subClassOf time:BusinessDay ,
                             time:Day ;
             owl:disjointWith time:Weekend ;
             rdfs:comment "A standard working business day." ;
             rdfs:label "Weekday" .


###  http://example.org/qsr_kg/QSRTimeOntology#Weekend
time:Weekend rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:unionOf ( [ rdf:type owl:Restriction ;
                                                   owl:onProperty qsr_kg:hasDayOfWeek ;
                                                   owl:hasValue qsr_kg:Friday
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty qsr_kg:hasDayOfWeek ;
                                                   owl:hasValue qsr_kg:Saturday
                                                 ]
                                               )
                                 ] ;
             rdfs:subClassOf time:BusinessDay ,
                             time:Day ;
             rdfs:comment "A non-standard business day with different demand patterns." ;
             rdfs:label "Weekend" .


#################################################################
#    Individuals
#################################################################

###  http://example.org/qsr_kg#CASH
qsr_kg:CASH rdf:type owl:NamedIndividual ,
                     qsr_kg:PaymentMethod .


###  http://example.org/qsr_kg#CREDIT_CARD
qsr_kg:CREDIT_CARD rdf:type owl:NamedIndividual ,
                            qsr_kg:PaymentMethod .


