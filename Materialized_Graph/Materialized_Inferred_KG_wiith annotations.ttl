qsr_kg:p rdf:type swrl:Variable .

qsr_kg:sd rdf:type swrl:Variable .

qsr_kg:ed rdf:type swrl:Variable .

qsr_kg:x rdf:type swrl:Variable .

qsr_kg:y rdf:type swrl:Variable .

qsr_kg:bd rdf:type swrl:Variable .

qsr_kg:d rdf:type swrl:Variable .

qsr_kg:dow rdf:type swrl:Variable .

[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "Promotional days" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate QSRPromotionsOntology:Promotion ;
                           swrl:argument1 qsr_kg:p
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate QSRPromotionsOntology:hasStartingBusinessDay ;
                                      swrl:argument1 qsr_kg:p ;
                                      swrl:argument2 qsr_kg:sd
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate QSRPromotionsOntology:hasEndingBusinessDay ;
                                                 swrl:argument1 qsr_kg:p ;
                                                 swrl:argument2 qsr_kg:ed
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                            swrl:propertyPredicate qsr_kg:date ;
                                                            swrl:argument1 qsr_kg:sd ;
                                                            swrl:argument2 qsr_kg:x
                                                          ] ;
                                                rdf:rest [ rdf:type swrl:AtomList ;
                                                           rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                                       swrl:propertyPredicate qsr_kg:date ;
                                                                       swrl:argument1 qsr_kg:ed ;
                                                                       swrl:argument2 qsr_kg:y
                                                                     ] ;
                                                           rdf:rest [ rdf:type swrl:AtomList ;
                                                                      rdf:first [ rdf:type swrl:ClassAtom ;
                                                                                  swrl:classPredicate time:BusinessDay ;
                                                                                  swrl:argument1 qsr_kg:bd
                                                                                ] ;
                                                                      rdf:rest [ rdf:type swrl:AtomList ;
                                                                                 rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                                                             swrl:propertyPredicate qsr_kg:date ;
                                                                                             swrl:argument1 qsr_kg:bd ;
                                                                                             swrl:argument2 qsr_kg:d
                                                                                           ] ;
                                                                                 rdf:rest [ rdf:type swrl:AtomList ;
                                                                                            rdf:first [ rdf:type swrl:BuiltinAtom ;
                                                                                                        swrl:builtin swrlb:greaterThanOrEqual ;
                                                                                                        swrl:arguments ( qsr_kg:d
                                                                                                                         qsr_kg:x
                                                                                                                       )
                                                                                                      ] ;
                                                                                            rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                       rdf:first [ rdf:type swrl:BuiltinAtom ;
                                                                                                                   swrl:builtin swrlb:lessThanOrEqual ;
                                                                                                                   swrl:arguments ( qsr_kg:d
                                                                                                                                    qsr_kg:y
                                                                                                                                  )
                                                                                                                 ] ;
                                                                                                       rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                  rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                                              swrl:propertyPredicate qsr_kg:isApplicableOn ;
                                                                                                                              swrl:argument1 qsr_kg:p ;
                                                                                                                              swrl:argument2 qsr_kg:bd
                                                                                                                            ] ;
                                                                                                                  rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                             rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                                                         swrl:propertyPredicate qsr_kg:hasDayOfWeek ;
